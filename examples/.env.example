# Jitsi Configuration
JITSI_BASE_URL=https://meet.example.com
BOSH_URL=http://prosody:5280/http-bind  # Для Docker
#BOSH_URL=http://localhost:5280/http-bind  # Для standalone
XMPP_DOMAIN=meet.example.com
MUC_DOMAIN=muc.meet.example.com

# XMPP Credentials
XMPP_USER=recorder
XMPP_PASSWORD=change-me-to-strong-password

# Recording Settings
OUTPUT_FORMAT=webm
AUTO_STOP_DELAY_MS=10000
TZ_OFFSET_H=3

# API Settings
PORT=3000
OUTPUT_DIR=/recordings
VENDOR_DIR=/app/vendor

# Security (optional)
API_TOKEN=
CORS_ORIGIN=*

# File Access (signed URLs)
FILE_ACCESS_SECRET_KEY=change-me-random-64-chars
FILE_ACCESS_EXPIRES_MINUTES=15
PUBLIC_BASE_URL=https://meet.example.com

# Fireflies Integration (optional)
FIREFLIES_ENABLED=false
FIREFLIES_API_KEY=
DELETE_AFTER_UPLOAD=false
